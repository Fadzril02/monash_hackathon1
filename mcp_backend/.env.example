# .env.example
# DO NOT PORT OR MCP_SERVER Related env variables here

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:PASSWORD@127.0.0.1:5432/ryt_guard # OPTIONAL

# Database connection settings (alternative to DATABASE_URL)
DB_HOST=127.0.0.1 # OPTIONAL - Change this to your PostgreSQL host
DB_PORT=5432 # OPTIONAL
DB_NAME=ryt_guard # OPTIONAL
DB_USER=postgres # OPTIONAL
DB_PASSWORD= # OPTIONAL